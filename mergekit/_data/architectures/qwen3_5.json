{
    "model_type": "qwen3_5_text",
    "architectures": [
        "Qwen3_5ForCausalLM"
    ],
    "pre_weights": [
        {
            "name": "model.embed_tokens.weight",
            "vocabulary_axis": 0
        }
    ],
    "post_weights": [
        {
            "name": "model.norm.weight"
        },
        {
            "name": "lm_head.weight",
            "vocabulary_axis": 0,
            "optional": true,
            "tied_names": [
                "model.embed_tokens.weight"
            ]
        }
    ],
    "num_layers_config_key": "num_hidden_layers",
    "layer_templates": {
        "weights": [
            {
                "name": "model.layers.${layer_index}.input_layernorm.weight"
            },
            {
                "name": "model.layers.${layer_index}.mlp.down_proj.weight"
            },
            {
                "name": "model.layers.${layer_index}.mlp.gate_proj.weight"
            },
            {
                "name": "model.layers.${layer_index}.mlp.up_proj.weight"
            },
            {
                "name": "model.layers.${layer_index}.post_attention_layernorm.weight"
            },
            {
                "name": "model.layers.${layer_index}.linear_attn.A_log",
                "optional": true
            },
            {
                "name": "model.layers.${layer_index}.linear_attn.conv1d.weight",
                "optional": true
            },
            {
                "name": "model.layers.${layer_index}.linear_attn.dt_bias",
                "optional": true
            },
            {
                "name": "model.layers.${layer_index}.linear_attn.in_proj_a.weight",
                "optional": true
            },
            {
                "name": "model.layers.${layer_index}.linear_attn.in_proj_b.weight",
                "optional": true
            },
            {
                "name": "model.layers.${layer_index}.linear_attn.in_proj_qkv.weight",
                "optional": true
            },
            {
                "name": "model.layers.${layer_index}.linear_attn.in_proj_z.weight",
                "optional": true
            },
            {
                "name": "model.layers.${layer_index}.linear_attn.norm.weight",
                "optional": true
            },
            {
                "name": "model.layers.${layer_index}.linear_attn.out_proj.weight",
                "optional": true
            },
            {
                "name": "model.layers.${layer_index}.self_attn.k_norm.weight",
                "optional": true
            },
            {
                "name": "model.layers.${layer_index}.self_attn.k_proj.weight",
                "optional": true
            },
            {
                "name": "model.layers.${layer_index}.self_attn.o_proj.weight",
                "optional": true
            },
            {
                "name": "model.layers.${layer_index}.self_attn.q_norm.weight",
                "optional": true
            },
            {
                "name": "model.layers.${layer_index}.self_attn.q_proj.weight",
                "optional": true
            },
            {
                "name": "model.layers.${layer_index}.self_attn.v_proj.weight",
                "optional": true
            }
        ]
    }
}
